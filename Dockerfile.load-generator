FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod ./
# uncomment if you have go.sum
COPY go.sum ./    
RUN go mod download
COPY load-generator ./load-generator
RUN go build -o load-generator-binary ./load-generator

FROM alpine:3.19
WORKDIR /app
COPY --from=build /app/load-generator-binary ./load-generator
ENTRYPOINT ["./load-generator"]