# ---------- Build stage ----------
FROM golang:1.22-alpine AS build

WORKDIR /app

# Copy go.mod (and go.sum if you have it) so dependencies can be cached
COPY go.mod ./
# COPY go.sum ./     # uncomment if you have go.sum

# Download dependencies
RUN go mod download

# Copy load-generator source
COPY load-generator ./load-generator

# Build the load generator binary
RUN go build -o load-generator ./load-generator

# ---------- Runtime stage ----------
FROM alpine:3.19

WORKDIR /app

# Copy the compiled binary from the build stage
COPY --from=build /app/load-generator ./load-generator

# Default command with some sane parameters; override via `docker run` if needed
ENTRYPOINT ["./load-generator"]
# Example default args (can be overridden):
# CMD ["-target", "http://server:8080/process", "-rate", "1000000", "-connections", "2000", "-duration", "30s"]
