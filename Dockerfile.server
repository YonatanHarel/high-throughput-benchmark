# ---------- Build stage ----------
FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod ./
# uncomment if you have go.sum
COPY go.sum ./   
RUN go mod download
COPY server ./server
RUN go build -o server-binary ./server

# ---------- Runtime stage ----------
FROM alpine:3.19
WORKDIR /app
# Copy the compiled binary
COPY --from=build /app/server-binary ./server-binary
# Copy only the config directory (NOT the whole server source)
COPY server/config ./server/config
ENV PORT=8080
EXPOSE 8080

CMD ["./server-binary"]